<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> – Understory</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <main class="page">

        <!-- Header / introduksjon -->
        <header class="page-header">
            <div class="page-eyebrow">Understory Innsikt</div>
            <h1 class="page-title">Se hvilke produkter som presterer best hos våre kunder</h1>
            <p class="page-subtitle">
                Få et overblikk over de best presterende opplevelsene og produktene på tvers av Understory-kundene. 
                Dette gir nye kunder innsikt i hvilke typer opplevelser som typisk leverer best tall i den angitte perioden.
            </p>
        </header>

        <!-- Toppliste-kortet (blurres hvis ikke innlogget) -->
        <section class="toplist-card <%= loggedIn ? '' : 'blurred' %>">
            <table class="toplist-table">
                <thead>
                    <tr>
                        <th>Produkt / opplevelse</th>
                        <th>Resultatindikator</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (companies && companies.length > 0) { %>
                        <% companies.forEach(function(company) { %>
                            <tr>
                                <td><%= company.name %></td>
                                <td><%= company.score %></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="2">Ingen produkter tilgjengelig.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </section>

        <!-- Info / call-to-action når man IKKE er innlogget -->
        <% if (!loggedIn) { %>
            <section class="paywall">
                <h2 class="paywall-title">Få full innsikt i hva som fungerer best</h2>
                <p class="paywall-subtitle">
                    Opprett en gratis konto eller logg inn for å se detaljert statistikk på de best presterende 
                    produktene og opplevelsene, og få et bedre grunnlag for hvilke konsepter som kan fungere best for dere.
                </p>

                <div class="paywall-cards">
                    <article class="paywall-card">
                        <p class="paywall-subtitle">
                            Ingen betalingsmur – vi bruker innlogging for å gi en trygg og tilpasset visning av data.
                        </p>
                        <div style="margin-top: 16px;">
                            <a href="/signup" class="btn btn-primary btn-block" style="margin-bottom: 8px;">
                                Opprett gratis konto
                            </a>
                            <a href="/login" class="btn btn-block">
                                Logg inn
                            </a>
                        </div>
                    </article>
                </div>
            </section>
        <% } %>

    </main>
</body>
</html>