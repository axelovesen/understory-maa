<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Understory Toplist</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="/JS/login.js" defer></script>
</head>
<body>
  <div class="page">

    <header class="site-header">
      <h1 class="site-title">Understory Toplist</h1>

      <% if (loggedIn) { %>
        <nav class="site-nav">
          <a href="/understory-toplist">Understory Toppliste</a>
          <a href="/logout">Logg ut</a>
        </nav>
      <% } else { %>
        <div class="site-nav">
          <button id="openLogin" class="btn btn-skjult">Logg inn</button>
          <button id="openSignup" class="btn btn-outline">Registrer deg</button>
        </div>
      <% } %>
    </header>

    <!-- Innhold -->
    <main class="main-content">
      
        <!-- Når bruker er innlogget -->
        <section class="intro">
          <h2 class="intro-title">Se hvilke opplevelser som leverer best</h2>
          <p class="intro-subtitle">Du er nå logget inn og kan se hele topplisten.</p>
        </section>

        <article class="grid">
          <h3 class="venstre-title">Utforsk Understory Toplist</h3>
          <p class="venstre-subtitle">
            Her kan du se de mest populære historiene basert på brukernes vurderinger og engasjement.
          </p>
          
          <div class="list-wrapper <%= loggedIn ? '' : 'blurred' %>">
          <% if (companies && companies.length > 0) { %>
            <ul class="list">
              <% companies.forEach(function(company, index) { %>
                <li class="list-item">
                  <span class="rank"><%= index + 1 %></span>
                  <span class="title"><%= company.name %></span>
                  <span class="score">Score: <%= company.score %></span>
                </li>
              <% }); %>
            </ul>
          <% } else { %>
            <p>Topplisten er låst. Vennligst logg inn for å se innholdet.</p>
          <% } %>
          </div>
        </article>

        <!--Høyre (info) avhengig login status-->
        <% if (loggedIn) { %>
          <article class="info-card">
            <h3 class="info-title">Logg in for å se tallene</h3>
            <p class="info-subtitle">
              Opprett en konto eller logg inn for å se full statistikk på de best preseternde produktene hos understory kundene, og for å få et bedre grunnlag for hvilke opplevelser som fungerer for dere.
            </p>
            <div class="cta-buttons">
              <button id="openSignupInfo" class="btn btn-primary btn-block">Registrer deg</button>
              <button id="openLoginInfo" class="btn btn-outline btn-block">Logg inn</button>
            </div>
          </article>
          <% } else { %>
          <article class="info-card">
            <h3 class="info-title">Du er innlogget</h3>
            <p class="info-subtitle">
              Du har nå full tilgang til Understory toplist, utforsk dataene og se hvilke opplevelser som presterer best!
            </p>
            <div class="cta-buttons">
              <a href="/understory-toplist" class="btn btn-primary btn-block">Gå til full Toppliste</a>
            </div>
          </article>



    <!-- Login-modal -->
    <div id="loginModal" class="modal hidden">
      <div class="modal-content">
        <span class="close" id="closeLogin">&times;</span>
        <h2>Logg inn på Understory</h2>

        <form id="loginForm">
          <input type="email" id="email" name="email" placeholder="E-post" required>
          <input type="password" id="password" name="password" placeholder="Passord" required>
          <button type="submit" class="btn btn-primary btn-block">Logg inn</button>
        </form>

        <p id="loginError" class="error-message"></p>
        <p class="auth-bunntekst">
          Har du ikke en konto?
          <button id="switchToSignup" class="btn btn-link">Registrer deg her</button>
        </p>
      </div>
    </div>

    <!-- Signup-modal -->
    <div id="signupModal" class="modal hidden">
      <div class="modal-content">
        <span class="close" id="closeSignup">&times;</span>
        <h2>Registrer deg - Understory</h2>
        <form id="signupForm">
          <input type="email" name="email" placeholder="E-post" required>
          <input type="password" name="password" placeholder="Passord" required>
          <button type="submit" class="btn btn-primary btn-block">Registrer deg</button>
        </form>
        <p id="signupError" class="error-message"></p>
      </div>
    </div>
  </div>
</body>
</html>

