<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Understory Toplist</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="/JS/login.js" defer></script>
  <script src="/JS/filters.js" defer></script>
</head>
<body>
  <div class="page">
    <a href="/views/om-oss" class="nav-link">Om oss</a>


    <header class="site-header">
      <h1 class="site-title">Understory Toplist</h1>

      <% if (loggedIn) { %>
        <nav class="site-nav">
          <a href="/logout" class="nav-button">Logg ut</a>
        </nav>
      <% } else { %>
        <div class="site-nav">
          <button id="openLogin" class="btn btn-skjult">Logg inn</button>
          <button id="openSignup" class="btn btn-outline">Registrer deg</button>
        </div>
      <% } %>
    </header>

    <!-- Innhold -->
    <main class="main">
      <!-- Når bruker er innlogget -->
      <section class="welcome-section">
        <h2>Velkommen til Understory Toplist!</h2>
         <p>
          Understory Toplist viser de mest vellykede kundene til Understory.<br>
          Se hvilke kunder som skaper mest egasjement, flest bookinger og høyest omsetning.<br>
          Logg inn for å låse opp og se topplisten
        </p>
      </section>

      <section class="toplist-section">

      <div class="filter-wrapper">
        <div class="filter-header">FILTRER ETTER:</div>
      <!--filterbar, venstre, tidsperiode-->
      <div class="filter-group">
        <button class="pill <%= period === '1M' ? 'pill-active' : '' %>" data-period="1M">Denne måneden</button>
        <button class="pill <%= period === '3M' ? 'pill-active' : '' %>" data-period="3M">De siste 3 månedene</button>
        <button class="pill <%= period === '6M' ? 'pill-active' : '' %>" data-period="6M">De siste 6 månedene</button>
        <button class="pill <%= period === '1Y' ? 'pill-active' : '' %>" data-period="1Y">De siste 12 månedene</button>
      </div>

      <div class="filter-group">
        <button class="pill small <%= sort === 'revenue' ? 'pill-active' : '' %>" data-sort="revenue">Høyest omsetning</button>
        <button class="pill small <%= sort === 'bookings' ? 'pill-active' : '' %>" data-sort="bookings">Flest bookinger</button>
        <button class="pill small <%= sort === 'clicks' ? 'pill-active' : '' %>" data-sort="clicks">Flest annonseklikk</button>
        <button class="pill small <%= sort === 'visits' ? 'pill-active' : '' %>" data-sort="visits">Flest besøkende</button>
      </div>
      </div>

      <% if (isDummy) { %>
        <div class="info-banner info-warning">
          Du ser en <strong>eksempeldata</strong>. Logg inn for å se ekte data.
        </div>
      <% } %>

      <% if (loggedIn) { %>
      <section class="toplist-section">
        
          <% if (companies && companies.length > 0) { %>
            <ul class="toplist">
              <% companies.forEach(function(company, index) { %>
                <li class="toplist-item">
                  <span class="rank"><%= index + 1 %></span>
                  <span class="title"><%= company.name %></span>
                   <% if (sort === 'revenue') { %>
                    <span class="metric <%= isDummy ? 'metric-blurred' : '' %>">
                      Omsetning: <%= company.revenue %> DKK
                    </span>
                  <% } else if (sort === 'bookings') { %>
                    <span class="metric <%= isDummy ? 'metric-blurred' : '' %>">
                      Bookinger: <%= company.bookings %>
                    </span>
                  <% } else if (sort === 'clicks') { %>
                    <span class="metric <%= isDummy ? 'metric-blurred' : '' %>">
                      Annonseklikk: <%= company.clicks %>
                    </span>
                  <% } else if (sort === 'visits') { %>
                    <span class="metric <%= isDummy ? 'metric-blurred' : '' %>">
                      Besøkende: <%= company.visits %>
                    </span>
                  <% } else { %>
                    <span class="metric <%= isDummy ? 'metric-blurred' : '' %>">
                      Score: <%= company.score %>
                    </span>
                  <% } %>
                  </li>
              <% }); %>
            </ul>
          <% } else { %>
          <% } %>
        </section>
      <% } else { %>

        <!-- Når bruker IKKE er innlogget -->
        <section class="toplist-section">
          <h2>Utforsk Understory Toplist</h2>
          <p class="section-subtitle">
            Her kan du se de mest populære historiene basert på brukernes vurderinger og engasjement.
          </p>
          <% if (companies && companies.length > 0) { %>
            <ul class="toplist">
              <% companies.forEach(function(company, index) { %>
                <li class="toplist-item">
                  <span class="rank"><%= index + 1 %></span>
                  <span class="title"><%= company.name %></span>

                  <% if (sort === 'revenue') { %>
                    <span class="metric">Omsetning: <%= company.revenue %> DKK</span>
                  <% } else if (sort === 'bookings') { %>
                    <span class="metric">Bookinger: <%= company.bookings %></span>
                  <% } else if (sort === 'clicks') { %>
                    <span class="metric">Annonseklikk: <%= company.clicks %></span>
                  <% } else if (sort === 'visits') { %>
                    <span class="metric">Besøkende: <%= company.visits %></span>
                  <% } else { %>
                    <span class="metric">Score: <%= company.score %></span>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          <% } else { %>
            <p>Ingen selskaper på topplisten enda.</p>
          <% } %>
        </section>
      <% } %>
      </section>
    </main>

    <!-- Login-modal -->
    <div id="loginModal" class="modal hidden">
      <div class="modal-content">
        <span class="close" id="closeLogin">&times;</span>
        <h2>Logg inn på Understory</h2>

        <form id="loginForm">
          <input type="email" id="email" name="email" placeholder="E-post" required>
          <input type="password" id="password" name="password" placeholder="Passord" required>
          <button type="submit" class="btn btn-primary btn-block">Logg inn</button>
        </form>

        <p id="loginError" class="error-message"></p>
        <p class="auth-bunntekst">
          Har du ikke en konto?
          <button id="switchToSignup" class="btn btn-link">Registrer deg her</button>
        </p>
      </div>
    </div>

    <!--2FA mondal-->
    <div id="twoFactorModal" class="modal hidden">
      <div class="modal-content">
        <span class="close" id="close2FA">&times;</span>
        <h2>Tofaktor autentifisering</h2>
        <p>Vi har en 6-sifret kode til telefonnummeret ditt. skriv inn koden for å fullføre innlogging</p>

        <input
          id="twoFactorCode"
          type="text"
          placeholder="Verifikasjonskode"
          inputmode="numeric"
          maxlength="6"
          required/>

          <p id="twoFactorError" class="error-message"></p>
          <button id="verify2FA" class="btn btn-primary btn-block">
            Bekreft kode
          </button>
      </div>
    </div>

    <!-- Signup-modal -->
    <div id="signupModal" class="modal hidden">
      <div class="modal-content">
        <span class="close" id="closeSignup">&times;</span>
        <h2>Registrer deg - Understory</h2>
        <form id="signupForm">
          <input type="email" name="email" placeholder="E-post" required>
          <input type="phone" name="phone" placeholder="Telefonnummer med landskode" required>
          <input type="password" name="password" placeholder="Passord" required>
          <button type="submit" class="btn btn-primary btn-block">Registrer deg</button>
        </form>
        <p id="signupError" class="error-message"></p>
      </div>
    </div>
  </div>
</body>
</html>