<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Understory Toplist</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="/JS/login.js" defer></script>
</head>
<body>
  <div class="page">

    <header class="site-header">
      <h1 class="site-title">Understory Toplist</h1>

      <% if (loggedIn) { %>
        <nav class="site-nav">
          <a href="/understory-toplist">Understory Toppliste</a>
          <a href="/logout">Logg ut</a>
        </nav>
      <% } else { %>
        <div class="site-nav">
          <button id="openLogin" class="btn btn-skjult">Logg inn</button>
          <button id="openSignup" class="btn btn-outline">Registrer deg</button>
        </div>
      <% } %>
    </header>

    <!-- Innhold -->
    <main class="main">
      <% if (loggedIn) { %>
        <!-- Når bruker er innlogget -->
        <section class="welcome-section">
          <h2>Velkommen tilbake til Understory Toplist!</h2>
          <p>Du er nå logget inn og kan se hele topplisten.</p>
        </section>

        <section class="toplist-section">
          <h2>Utforsk Understory Toplist</h2>
          <p class="section-subtitle">
            Her kan du se de mest populære historiene basert på brukernes vurderinger og engasjement.
          </p>

          <% if (companies && companies.length > 0) { %>
            <ul class="toplist">
              <% companies.forEach(function(company, index) { %>
                <li class="toplist-item">
                  <span class="rank"><%= index + 1 %></span>
                  <span class="title"><%= company.name %></span>
                  <span class="score">Score: <%= company.score %></span>
                </li>
              <% }); %>
            </ul>
          <% } else { %>
            <p>Topplisten er låst. Vennligst logg inn for å se innholdet.</p>
          <% } %>
        </section>

      <% } else { %>
        <!-- Når bruker IKKE er innlogget -->
        <section class="welcome-section">
          <h2>Velkommen til Understory Toplist!</h2>
          <p>For å få full tilgang til Understory toplist, vennligst logg inn eller registrer deg.</p>
        </section>

        <section class="toplist-section">
          <h2>Utforsk Understory Toplist</h2>
          <p class="section-subtitle">
            Her kan du se de mest populære historiene basert på brukernes vurderinger og engasjement.
          </p>

          <% if (companies && companies.length > 0) { %>
            <ul class="toplist">
              <% companies.forEach(function(company, index) { %>
                <li class="toplist-item">
                  <span class="rank"><%= index + 1 %></span>
                  <span class="title"><%= company.name %></span>
                  <span class="score">Score: <%= company.score %></span>
                </li>
              <% }); %>
            </ul>
          <% } else { %>
            <p>Ingen selskaper på topplisten enda.</p>
          <% } %>
        </section>
      <% } %>
    </main>

    <!-- Login-modal -->
    <div id="loginModal" class="modal hidden">
      <div class="modal-content">
        <span class="close" id="closeLogin">&times;</span>
        <h2>Logg inn på Understory</h2>

        <form id="loginForm">
          <input type="email" id="email" name="email" placeholder="E-post" required>
          <input type="password" id="password" name="password" placeholder="Passord" required>
          <button type="submit" class="btn btn-primary btn-block">Logg inn</button>
        </form>

        <p id="loginError" class="error-message"></p>
        <p class="auth-bunntekst">
          Har du ikke en konto?
          <button id="switchToSignup" class="btn btn-link">Registrer deg her</button>
        </p>
      </div>
    </div>

    <!-- Signup-modal -->
    <div id="signupModal" class="modal hidden">
      <div class="modal-content">
        <span class="close" id="closeSignup">&times;</span>
        <h2>Registrer deg - Understory</h2>
        <form id="signupForm">
          <input type="email" name="email" placeholder="E-post" required>
          <input type="password" name="password" placeholder="Passord" required>
          <button type="submit" class="btn btn-primary btn-block">Registrer deg</button>
        </form>
        <p id="signupError" class="error-message"></p>
      </div>
    </div>
  </div>
</body>
</html>