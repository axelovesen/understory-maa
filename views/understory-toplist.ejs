<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>understory-toplist</title>
</head>
<body>
    <main class="page">
        <h1>Understory Bjellesauer - Toppliste</h1>
        <table>
            <thead>
                <tr>
                    <th>Plassering</th>
                    <th>Navn</th>
                    <th>Score</th>
                </tr>
            </thead>
            <tbody>
                <% toplist.forEach((entry, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><%= entry.name %></td>
                        <td><%= entry.points %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </main>
</body>
</html>