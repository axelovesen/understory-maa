<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>2FA login understory"</title>
</head>
<body>
    <h1>Two-factor autentifisering</h1>
    <p>verifikasjons kode er sendt på SMS, skriv koden for å fullføre login.</p>

    <% if (typeof error !== 'undefined') { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form action="/2fa" method="POST">
        <label for="code">Verifikasjons kode</label>
        <input id="code" name="code" type="text" required />

        <button type="submit">Confirm</button>
    </form>
    
</body>
</html>