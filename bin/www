#!/usr/bin/env node

var app = require('../app');
var debug = require('debug')('understory-maa:server');
var http = require('http');

//henter port fra miljø eller 300
var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

//lager HTTP server
var server = http.createServer(app);

//lytt på port, på alle grensesnitt
server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

//functiom som normaliserer porten
function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    //named pipe
    return val;
  }

  if (port >= 0) {
    // port nummmer
    return port;
  }

  return false;
}

//håndterer spesielle lytte feil
function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  //handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

//logg når serveren lytter

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
